# Development template. Production uses ONE public HTTPS origin:
# NEXT_PUBLIC_SITE_URL=https://clinic.example.test
# NEXT_PUBLIC_API_URL=https://clinic.example.test/api/v1
# API_UPSTREAM_ORIGIN=https://api.example.test
# example.test and public-config-only-key are build fixtures, NOT release values.
# The fixed API upstream is server-side deployment configuration, never NEXT_PUBLIC.
# Express API base. Keep the /api/v1 path; no trailing slash is required.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production-only fixed upstream for the narrow /api/v1/:path* edge rewrite.
# Must be a non-local HTTPS origin without credentials, path, query, or fragment.
# Local development talks to NEXT_PUBLIC_API_URL directly and may leave this empty.
API_UPSTREAM_ORIGIN=

# Public Cloudinary account name used to narrowly allow managed clinic images.
# Leave empty until the deployment account is known; unapproved remote images
# render as safe placeholders.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Production must use Turnstile and provide its public site key. Local tests and
# the deterministic preview explicitly use disabled and never contact Cloudflare.
NEXT_PUBLIC_BOOKING_CHALLENGE_PROVIDER=disabled
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/dental_clinic_db

JWT_SECRET=replace_with_at_least_48_random_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
APPOINTMENT_QUOTA_SECRET=replace_with_a_separate_48_character_random_secret
APPOINTMENT_QUOTA_KEY_VERSION=v1
RATE_LIMIT_KEY_SECRET=replace_with_another_48_character_random_secret
AUDIT_PSEUDONYM_SECRET=replace_with_a_fourth_48_character_random_secret
APPOINTMENT_PRIVACY_POLICY_VERSION=2026-01
BOOKING_IDEMPOTENCY_TTL_HOURS=24

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
REQUIRE_HTTPS=false
TRUST_PROXY_HOPS=0
TRUST_PROXY_CIDRS=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_DOMAIN=
API_REPLICA_COUNT=1
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000
MEDIA_CLEANUP_MAX_ATTEMPTS=8
MEDIA_CLEANUP_BACKOFF_BASE_SECONDS=60
MEDIA_CLEANUP_BACKOFF_MAX_SECONDS=86400
MEDIA_CLEANUP_REFERENCE_RETRY_SECONDS=3600
MEDIA_CLEANUP_STALE_LOCK_SECONDS=900
INVITE_TOKEN_TTL_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=30
BEFORE_AFTER_CONSENT_VERSION=2026-01
LEGACY_CONTENT_LOCALE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000
CLINIC_TIMEZONE=Asia/Yerevan
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info
ERROR_MONITOR_WEBHOOK_URL=
HEALTH_CHECK_TIMEOUT_MS=1500
READINESS_CACHE_MS=3000
READINESS_FAILURE_CACHE_MS=1000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000
PUBLIC_BOOKING_CHALLENGE_PROVIDER=disabled
PUBLIC_BOOKING_CHALLENGE_SECRET=
PUBLIC_BOOKING_CHALLENGE_TIMEOUT_MS=2000

# Bootstrap-only inputs for `npm run seed:admin`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_ACKNOWLEDGED=false
PRODUCTION_MAINTENANCE_ACK=
PRODUCTION_WRITES_DRAINED=false

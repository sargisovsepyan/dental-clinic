NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/dental_clinic_db

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
APPOINTMENT_QUOTA_SECRET=replace_with_a_separate_32_character_random_secret
RATE_LIMIT_KEY_SECRET=replace_with_another_32_character_random_secret

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
REQUIRE_HTTPS=false
TRUST_PROXY_HOPS=0
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_DOMAIN=
API_REPLICA_COUNT=1
RATE_LIMIT_STORE=memory
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000
MEDIA_CLEANUP_MAX_ATTEMPTS=8
MEDIA_CLEANUP_BACKOFF_BASE_SECONDS=60
MEDIA_CLEANUP_BACKOFF_MAX_SECONDS=86400
MEDIA_CLEANUP_REFERENCE_RETRY_SECONDS=3600
MEDIA_CLEANUP_STALE_LOCK_SECONDS=900
INVITE_TOKEN_TTL_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=30
BEFORE_AFTER_CONSENT_VERSION=2026-01
LEGACY_CONTENT_LOCALE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CLINIC_TIMEZONE=Asia/Yerevan
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info
ERROR_MONITOR_WEBHOOK_URL=
HEALTH_CHECK_TIMEOUT_MS=1500
GRACEFUL_SHUTDOWN_TIMEOUT_MS=15000

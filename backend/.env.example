NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/dental_clinic_db

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
APPOINTMENT_QUOTA_SECRET=replace_with_a_separate_32_character_random_secret

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
INVITE_TOKEN_TTL_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CLINIC_TIMEZONE=Asia/Yerevan
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
